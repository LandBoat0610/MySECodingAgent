# ================================================================
# Agent Platform - 环境变量配置模板
# 复制此文件为 .env 并填入实际值
#   cp .env.example .env
# ================================================================

# ---------- LLM API 配置（必填）----------
# API 密钥
OPENAI_API_KEY=sk-your-api-key-here

# API 地址（默认为 OpenAI 官方，可使用第三方兼容 API）
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型名称
OPENAI_MODEL=gpt-4o-mini

# ---------- 镜像配置（CI/CD 自动注入，本地部署可手动指定）----------
# 镜像仓库前缀（GitLab CI 自动使用 $CI_REGISTRY_IMAGE）
IMAGE_NAME=agent-platform

# 镜像标签（GitLab CI 自动使用 commit SHA）
IMAGE_TAG=latest

# ---------- 可选配置 ----------
# Python 输出不缓冲（建议保持 1）
PYTHONUNBUFFERED=1
